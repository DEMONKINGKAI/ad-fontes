# Keep code and config LF in the repo so Linux CI and Windows dev agree
# (ruff format is line-ending sensitive on --check).
*.py    text eol=lf
*.pyi   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf
*.ipynb text eol=lf
