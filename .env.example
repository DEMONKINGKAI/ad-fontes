# ---------------------------------------------------------------------------
# ad fontes — backend configuration
# Copy to .env for local dev. On Hugging Face Spaces set these as Secrets.
# Every value here has a safe default in app/config.py except HF_TOKEN.
# ---------------------------------------------------------------------------

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of origins permitted to call the API. The Vercel
# portfolio site goes here. No wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Hosted fallback generation -------------------------------------------
# Used only when local GGUF generation exceeds AD_FONTES_LOCAL_TIMEOUT_S.
# Responses produced this way are marked generator="hosted-fallback".
# A HF Pro token also raises the rate limits for the Phase 3 LLM judge.
HF_TOKEN=
AD_FONTES_HOSTED_MODEL=Qwen/Qwen2.5-7B-Instruct
AD_FONTES_HOSTED_PROVIDER=auto

# --- Generation -----------------------------------------------------------
# Default generator when the request does not specify one.
AD_FONTES_DEFAULT_MODEL=tuned
# Seconds to wait for local llama.cpp before falling back to the hosted model.
AD_FONTES_LOCAL_TIMEOUT_S=25
# GGUF locations. Paths are resolved inside the container (models baked at build
# time); repo ids are the source of truth for the build step.
AD_FONTES_BASE_GGUF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
AD_FONTES_BASE_GGUF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
AD_FONTES_TUNED_GGUF_REPO=DEMONKINGKAI/ad-fontes-generator-1.5b-dpo-gguf
AD_FONTES_TUNED_GGUF_FILE=ad-fontes-1.5b-dpo-q4_k_m.gguf

# --- Models: retrieval + verification ----------------------------------
AD_FONTES_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
AD_FONTES_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# --- Paths ---------------------------------------------------------------
AD_FONTES_CORPUS_DIR=data/corpus
AD_FONTES_INDEX_DIR=data/index
AD_FONTES_FEEDBACK_DIR=data/feedback

# --- Public-endpoint safety -------------------------------------------
AD_FONTES_RATE_LIMIT_REQUESTS=10
AD_FONTES_RATE_LIMIT_WINDOW_S=300
AD_FONTES_MAX_QUESTION_CHARS=400

# --- Server ------------------------------------------------------------
# HF Spaces expects the app on 7860; local compose uses 8000.
AD_FONTES_PORT=8000
AD_FONTES_LOG_LEVEL=INFO
